{
  // One-click reproduction of the pilot analysis: open in Codespaces, then follow "Reproduce" in the README.
  // No API keys are needed or wanted here; paid runs are out of scope for this environment.
  "name": "petri-judge-stability",
  // 3.13 is the version the README says was tested.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "postCreateCommand": "pip install -q -r requirements.txt",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  },
  "hostRequirements": { "cpus": 2 }
}
